# Copy this file to .env.local and replace placeholders with local/test values.
NODE_ENV=development

PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=1
# Shared parent domain for cross-subdomain cookies in production; blank for localhost.
COOKIE_DOMAIN=

DATABASE_URL=postgresql://database_user:database_password@localhost:5432/unicorn?schema=public

# Required only when running the administrator seed.
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

BCRYPT_SALT_ROUNDS=12
TAX_PERCENTAGE=16
MODIFICATION_FEE=0

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_SECRET=replace_with_a_long_random_reset_secret
JWT_RESET_EXPIRES_IN=15m

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
PAYMENT_CURRENCY=kes
